# Server-side only. Copy to .env.local; never commit actual credentials.
# Project origin, e.g. https://your-project.supabase.co (not /rest/v1/).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Canonical HTTPS origin in production: https://labora-mu.vercel.app
# Leave empty locally to use the request URL; never deploy a localhost APP_URL.
APP_URL=
SUPABASE_SECRET_KEY=
# Set only behind an ingress that overwrites X-Real-IP. Vercel is detected automatically.
TRUST_PROXY=0
