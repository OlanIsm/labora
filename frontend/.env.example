# Server-side only. Copy to .env.local; never commit actual credentials.
# Project origin, e.g. https://your-project.supabase.co (not /rest/v1/).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
APP_URL=http://localhost:3000
SUPABASE_SECRET_KEY=
# Set only behind an ingress that overwrites X-Real-IP. Vercel is detected automatically.
TRUST_PROXY=0
